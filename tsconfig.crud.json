{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "src/lib/adminTeachersRepository.ts",
    "src/lib/adminStudentsRepository.ts",
    "src/lib/adminClassesRepository.ts",
    "src/lib/gradesRepository.ts",
    "src/lib/attendanceRepository.ts",
    "src/lib/index.ts",
    "src/lib/production/errors.ts",
    "src/lib/production/types.ts",
    "src/lib/production/store.ts",
    "src/lib/production/rbac.ts",
    "src/lib/production/query.ts",
    "src/lib/production/audit.ts",
    "src/lib/production/schoolDataService.ts",
    "src/lib/production/syncService.ts"
  ]
}
